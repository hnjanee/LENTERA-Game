{
  "title": "LENTERA Session State Schema",
  "description": "Skema validasi state sesi permainan LENTERA - localStorage client",
  "version": "1.0.0",

  "sessionId": {
    "type": "string",
    "pattern": "^ln_[a-z0-9]+_[a-z0-9]{4,8}$",
    "description": "ID unik sesi. Format: ln_{timestamp36}_{random6}"
  },

  "currentScreen": {
    "type": "string",
    "enum": ["loading", "pos1", "pos2", "pos3", "pos4", "hasil"]
  },

  "player": {
    "nama": { "type": "string", "maxLength": 30 },
    "avatarConfig": {
      "cuaca": {
        "enum": ["cerah", "kabut", "mendung", null],
        "scoring": {
          "cerah":   { "skor_resiliensi": 3, "interpretasi": "Stabil/Positif" },
          "kabut":   { "skor_resiliensi": 2, "interpretasi": "Cemas/Overthinking" },
          "mendung": { "skor_resiliensi": 1, "interpretasi": "Sedih/Banyak beban" }
        }
      },
      "tas": {
        "enum": ["buku", "hp", "kaca", null],
        "scoring": {
          "buku": { "stres_type": "akademik",   "interpretasi": "Stres akademik" },
          "hp":   { "stres_type": "sosial",     "interpretasi": "Stres sosial/cyberbullying" },
          "kaca": { "stres_type": "insecurity", "interpretasi": "Insecurity" }
        }
      },
      "qte": {
        "enum": ["menunduk", "panik", "senyum", null],
        "scoring": {
          "menunduk": { "skor_resiliensi": 1, "interpretasi": "Pasif, tidak berdaya" },
          "panik":    { "skor_resiliensi": 2, "interpretasi": "People pleaser" },
          "senyum":   { "skor_resiliensi": 3, "interpretasi": "Resiliensi baik" }
        }
      },
      "baterai": {
        "enum": ["keramaian", "pojok", "pohon", null],
        "scoring": {
          "keramaian": { "skor_isolasi": 1, "interpretasi": "Aman berinteraksi" },
          "pojok":     { "skor_isolasi": 2, "interpretasi": "Butuh ruang personal" },
          "pohon":     { "skor_isolasi": 3, "interpretasi": "Menarik diri" }
        }
      }
    }
  },

  "skor": {
    "resiliensi": {
      "type": "integer", "minimum": 0, "maximum": 9,
      "description": "cuaca(1-3) + qte(1-3) + pos2(3 x maks3), di-cap 9"
    },
    "isolasi": {
      "type": "integer", "minimum": 0, "maximum": 3,
      "description": "Dari baterai sosial (1=aman, 3=isolatif)"
    },
    "stresType": {
      "enum": ["akademik", "sosial", "insecurity", null]
    },
    "pos2Responses": {
      "type": "array", "maxItems": 3,
      "item_schema": {
        "skenario": "integer 1-3",
        "pilihan": "A|B|C",
        "tipe": "pasif|internalisasi|menarikdiri|reaktif|asertif",
        "skor": "integer 1-3"
      },
      "tipe_mapping": {
        "A": { "skenario1": "pasif/1",         "skenario2": "internalisasi/1", "skenario3": "menarikdiri/1" },
        "B": { "skenario1": "reaktif/2",        "skenario2": "reaktif/2",       "skenario3": "reaktif/2" },
        "C": { "skenario1": "asertif/3",        "skenario2": "asertif/3",       "skenario3": "asertif/3" }
      }
    },
    "pos3Complete": { "type": "boolean" }
  },

  "laporan": {
    "isi":       { "type": "string", "maxLength": 2000 },
    "isAnonim":  { "type": "boolean", "default": true },
    "submitted": { "type": "boolean", "default": false },
    "skipped":   { "type": "boolean", "default": false }
  },

  "hasil": {
    "tipe": {
      "enum": ["ksatria", "daun", null],
      "kriteria": {
        "ksatria": "resiliensi >= 7 DAN isolasi <= 1",
        "daun":    "resiliensi < 7  ATAU isolasi >= 2"
      },
      "deskripsi": {
        "ksatria": "Ksatria Lentera - Tangguh, asertif, bercahaya",
        "daun":    "Daun Terduduk - Sedang lelah, perlu dukungan"
      }
    },
    "totalSkor":    { "type": "integer", "minimum": 0, "maximum": 100 },
    "persentase":   { "type": "integer", "minimum": 0, "maximum": 100 },
    "kalkulasiDone":{ "type": "boolean" },
    "formula":      "totalSkor = (resiliensi/9 x 70) + ((4-isolasi)/3 x 30)"
  },

  "posCompleted": {
    "pos1": { "type": "boolean" },
    "pos2": { "type": "boolean", "requires": "pos1=true" },
    "pos3": { "type": "boolean", "requires": "pos2=true" },
    "pos4": { "type": "boolean", "requires": "pos3=true" }
  },

  "storage": {
    "key":    "lentera_session_v1",
    "engine": "localStorage",
    "expiry": "24 jam dari startedAt"
  },

  "trigger_konseling": "tipe = daun ATAU laporan.submitted = true",

  "examples": {
    "sesi_selesai_ksatria": {
      "sessionId": "ln_lx3k7a_d9mf2q",
      "currentScreen": "hasil",
      "player": { "nama": "Budi", "avatarConfig": { "cuaca": "cerah", "tas": "buku", "qte": "senyum", "baterai": "pojok" } },
      "skor": { "resiliensi": 9, "isolasi": 2, "stresType": "akademik", "pos3Complete": true,
        "pos2Responses": [
          { "skenario": 1, "pilihan": "C", "tipe": "asertif", "skor": 3 },
          { "skenario": 2, "pilihan": "C", "tipe": "asertif", "skor": 3 },
          { "skenario": 3, "pilihan": "C", "tipe": "asertif", "skor": 3 }
        ]
      },
      "laporan": { "isi": "", "isAnonim": true, "submitted": false, "skipped": true },
      "hasil": { "tipe": "ksatria", "totalSkor": 83, "persentase": 83, "kalkulasiDone": true },
      "posCompleted": { "pos1": true, "pos2": true, "pos3": true, "pos4": true }
    },
    "sesi_selesai_daun_laporan": {
      "sessionId": "ln_lx9a2b_h4kt8r",
      "currentScreen": "hasil",
      "player": { "nama": "Anonim", "avatarConfig": { "cuaca": "mendung", "tas": "hp", "qte": "menunduk", "baterai": "pohon" } },
      "skor": { "resiliensi": 4, "isolasi": 3, "stresType": "sosial", "pos3Complete": true,
        "pos2Responses": [
          { "skenario": 1, "pilihan": "A", "tipe": "pasif",         "skor": 1 },
          { "skenario": 2, "pilihan": "A", "tipe": "internalisasi", "skor": 1 },
          { "skenario": 3, "pilihan": "A", "tipe": "menarikdiri",   "skor": 1 }
        ]
      },
      "laporan": { "isi": "[TERENKRIPSI]", "isAnonim": true, "submitted": true, "skipped": false },
      "hasil": { "tipe": "daun", "totalSkor": 38, "persentase": 38, "kalkulasiDone": true },
      "posCompleted": { "pos1": true, "pos2": true, "pos3": true, "pos4": true }
    }
  }
}
